# Names only. Copy to .env and fill in locally. Never commit .env.
# Values and the exact list may change in later slices.

# PayPal sandbox REST app (developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google AI Studio key (free tier, no card). Send only synthetic data.
GEMINI_API_KEY=

# live (default) or replay
LLM_MODE=live

# API server
PORT=3000
